{
  "name": "Track",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "artist_id": {
      "type": "string",
      "description": "Reference to Artist"
    },
    "artist_name": {
      "type": "string"
    },
    "album": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "plays": {
      "type": "number",
      "default": 0
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "audio_url": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "artist_name"
  ]
}