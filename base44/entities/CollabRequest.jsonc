{
  "name": "CollabRequest",
  "type": "object",
  "properties": {
    "artist_id": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "requester_name": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "project_type": {
      "type": "string",
      "enum": [
        "Single",
        "EP",
        "Album",
        "Feature",
        "Remix",
        "Live Performance",
        "Other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending"
    }
  },
  "required": [
    "artist_id",
    "artist_name",
    "message"
  ]
}